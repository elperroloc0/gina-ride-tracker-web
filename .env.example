# Copy to .env.local (gitignored) and fill in your own values - see src/map/mapboxToken.ts.

# Public Mapbox access token (starts "pk."), from
# https://account.mapbox.com/access-tokens/. Without it the app falls back to
# the static map placeholder.
#
# This only feeds `npm run dev`/`npm run build` run directly on the host.
# Under docker compose (see ../GinaGymnastics/compose.yaml), the same value
# is instead read from GinaGymnastics/.env and passed to this repo's
# Dockerfile as a build arg - Vite inlines it at build time either way, so
# there is no runtime env var to set inside the container.
VITE_MAPBOX_TOKEN=

# Base URL of the Django API when it's on a different origin than this app
# (e.g. this app on Vercel, API on a VPS) - see src/api/apiBase.ts. Leave
# unset for local dev (Vite proxies /api, /ws) or any same-origin deploy.
VITE_API_URL=
